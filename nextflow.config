// mag_export_nf configuration

params {
    mag_dir            = null      // required: folder of MAG fasta files
    mag_ext            = ''        // suffix to append to table names lacking it
    on_missing         = 'warn'    // warn | fail
    tables             = []        // list of table entries; see params.example.yaml

    // annotation
    eggnog_db          = null      // eggNOG-mapper data dir (needed if any table has annotate: true)
    download_eggnog_db = false     // true: download the DB into eggnog_db if not already there (~50 GB)
    pyrodigal_mode     = 'single'  // single (falls back to meta if a MAG is too small) | meta
    eggnog_batch_size  = 50        // MAGs per eggNOG-mapper run
    emapper_args       = ''        // extra emapper.py options
    emapper_cpus       = 16
}

process {
    withLabel: 'small' { cpus = 1 }
    withLabel: 'big'   { cpus = { params.emapper_cpus } }
}

profiles {
    // per-process conda envs from envs/*.yml, built once and cached
    conda {
        conda.enabled  = true
        conda.cacheDir = "${System.getenv('HOME')}/.cache/mag_export_nf/conda"
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        conda.cacheDir = "${System.getenv('HOME')}/.cache/mag_export_nf/conda"
    }
    // tiny synthetic run (annotation off unless you pass --eggnog_db)
    test {
        params.mag_dir      = "${projectDir}/tests/data/mags"
        params.emapper_cpus = 2
        params.tables = [
            [table: "${projectDir}/tests/data/decreasing.tsv", header: false, column: 1,
             dest: 'test_results/decreasing', annotate: false],
            [table: "${projectDir}/tests/data/increasing.tsv", header: false, column: 1,
             dest: 'test_results/increasing', annotate: false],
            [table: "${projectDir}/tests/data/maaslin3.tsv", header: true, column: 'feature',
             dest: 'test_results/maaslin3', annotate: false],
        ]
    }
}

manifest {
    name            = 'mag_export_nf'
    description     = 'Copy MAG fastas listed in tables and optionally annotate them (pyrodigal + eggNOG-mapper)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}
